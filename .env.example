# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# AbacatePay (API routes/Vercel — nunca prefixe com VITE_)
# Use uma chave dev_ para testes e prod_ em produção.
ABACATEPAY_API_KEY=your_abacatepay_api_key
ABACATEPAY_WEBHOOK_SECRET=your_random_webhook_secret
# Os produtos mensal e anual são localizados/criados automaticamente pela API.
# A chave precisa permitir leitura/criação de produtos e criação de assinaturas.

# Backend / persistência de assinaturas
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# URL pública da aplicação, usada nos callbacks do checkout
APP_URL=http://localhost:5173


# ============================================
# INSTRUÇÕES
# ============================================
# 1. Copie este arquivo: cp .env.example .env.local
# 2. Preencha com suas chaves reais da AbacatePay e do Supabase
# 3. NUNCA commite .env.local no Git
# 4. Configure as mesmas variáveis no Vercel (Settings → Environment Variables)
