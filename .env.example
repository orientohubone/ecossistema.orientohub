# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Asaas (API routes/Vercel — nunca prefixe com VITE_)
# Sandbox: https://api-sandbox.asaas.com/v3
# Produção: https://api.asaas.com/v3
ASAAS_API_KEY=your_asaas_api_key
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=your_random_webhook_token

# Backend / persistência de assinaturas
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# URL pública da aplicação, usada nos callbacks do checkout
APP_URL=http://localhost:5173


# ============================================
# INSTRUÇÕES
# ============================================
# 1. Copie este arquivo: cp .env.example .env.local
# 2. Preencha com suas chaves reais do Asaas e do Supabase
# 3. NUNCA commite .env.local no Git
# 4. Configure as mesmas variáveis no Vercel (Settings → Environment Variables)
